---
// Block 4: aged perforated page held by tape.
import MarginMark from "./MarginMark.astro";
import SheetHeader from "./SheetHeader.astro";
import { benefits } from "../data/landing";
---

<section
  class="relative mx-10 -rotate-[0.7deg] drop-shadow-sheet md:mr-benefits-r md:ml-benefits-l md:max-w-920 md:drop-shadow-sheet-md"
>
  <!-- Tape lies on top of the sheet, outside its perforation mask -->
  <div
    class="absolute -top-10 right-36 z-2 h-24 w-84 rotate-5 bg-tape shadow-tape md:-top-12 md:right-80 md:h-28 md:w-110"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute -top-10 left-70 z-2 hidden h-28 w-96 -rotate-4 bg-tape shadow-tape md:block"
    aria-hidden="true"
  >
  </div>
  <div
    class="relative flex flex-col bg-paper-aged paper-lined perforation-top pt-42 pr-72 pb-38 pl-26 md:pr-sheet-r md:pl-sheet-l"
  >
    <SheetHeader date={benefits.date} title={benefits.title} />
    <ul class="mt-row flex flex-col gap-row md:grid md:notes-grid md:gap-x-40">
      {
        benefits.items.map((item) => (
          <li class="relative md:flex md:gap-8">
            <MarginMark tone="green">✓</MarginMark>
            <p class="font-sans text-body text-pretty text-ink-body md:text-body-md">
              <b class="font-bold text-ink-strong">{item.lead}</b>{" "}{item.text}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
